# GitHub Secrets–aligned names (required)
PROJECT_ID=your-supabase-project-ref
SECRET_KEY=your-supabase-secret-key

# Optional (publishable / anon key — not used for server writes)
PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional volume floors (defaults shown)
# SCRAPER_TARGET_MIN=120
# SCRAPER_SUPPORT_MIN=30
# SCRAPER_SALES_MIN=30
