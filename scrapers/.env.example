# Required — no hardcoded project fallback in the scraper or CI
SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only secret for Python supabase-py upserts (GitHub Actions / CI).
# SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy alias.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Optional volume floors (defaults shown)
# SCRAPER_TARGET_MIN=120
# SCRAPER_SUPPORT_MIN=30
# SCRAPER_SALES_MIN=30
