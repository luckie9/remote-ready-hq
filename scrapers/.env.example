# Copy values from the project root .env.local (or set directly)
SUPABASE_URL=https://your-project.supabase.co

# Browser / client-safe (publishable). Never use for privileged inserts.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret for Python supabase-py inserts (GitHub Actions / CI).
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
