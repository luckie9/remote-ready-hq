# Copy to .env.local and fill in real values. Never commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional alias (used as fallback by server code)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_..._or_rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_1ULr5oKGX7AjcEKE1XO7gfp9
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_1ULr5oKGX7AjcEKE1XO7gfp9
STRIPE_PRICE_ID_TRIAL=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUBSCRIPTION_COOKIE_SECRET=change-me

# Email digest (Resend + Vercel Cron)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="RemoteReady HQ <alerts@yourdomain.com>"
CRON_SECRET=generate-a-long-random-string

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin
ADMIN_EMAILS=
ADMIN_API_SECRET=
